# Copy this file to `.env` and fill in the secrets before starting the
# stack — every secret below ships EMPTY on purpose (AC19): both apps
# refuse to start rather than run with an absent or guessable secret.
# Generate each one with:
#   openssl rand -hex 32

# Shared secret between apps/web and apps/api — never sent to the browser.
INTERNAL_API_SECRET=

# NextAuth v5's session-signing secret (var name confirmed in T9 against
# current docs — NEXTAUTH_SECRET or AUTH_SECRET).
NEXTAUTH_SECRET=

# Postgres.
POSTGRES_USER=focusflow
POSTGRES_PASSWORD=
POSTGRES_DB=focusflow

# Internal address apps/web's Server Actions call apps/api at — not a
# secret, safe to leave as the Compose service name.
API_BASE_URL=http://api:8000

# QA-only: shortens the Pomodoro interval lengths so a manual E2E pass
# doesn't require a real 25-minute wait. Leave empty in any deployment
# you're not actively testing against — see the spec's Never-do.
POMODORO_TEST_SHORT_INTERVALS=
